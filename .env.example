# CortIQ — Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env to git

# ── Supabase (required) ──────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"        # safe to expose in browser

# ── Google OAuth (optional — required for Search Console integration) ────────
# Create credentials at: console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://YOUR_PROJECT_ID.supabase.co/functions/v1/gsc-oauth-callback
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ── CortIQ marketing-site self-tracking (optional) ───────────────────────────
# CortIQ measuring cortiq.se itself (optional). When both are set, the build injects the
# consent-gated tracker into index.html (scripts/self-tracking-snippet.mjs); leave them empty
# for a build without tracking. Values: the cortiq.se site's id and tracking key from the
# dashboard (Setup tab). TRACK_URL defaults to the production Edge Functions base.
VITE_CORTIQ_SITE_ID=""
VITE_CORTIQ_TRACKING_KEY=""
# VITE_CORTIQ_TRACK_URL="https://your-project-id.supabase.co/functions/v1"
