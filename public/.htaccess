# CortIQ — Apache config for SPA + prerendered marketing pages
# Host: Loopia (nginx terminates TLS and forwards to Apache over plain http).
#
# Why this file matters for SEO:
#   The prerenderer writes dist/<route>/index.html (a directory per route) and the
#   canonical form of every marketing URL is the directory WITH a trailing slash
#   (https://cortiq.se/features/) — canonical tags, sitemap and internal links all
#   use it (src/marketing-routes.ts), and Apache serves it directly as 200.
#   The no-slash form gets one explicit 301 to https + slash. Without rule 3,
#   mod_dir would do that redirect itself but build it as http:// (it only sees
#   the proxy's plain http), producing a two-hop http -> https chain.

# Security headers. The Content-Security-Policy is report-only until violations on the live
# site (marketing pages, dashboard, session replay, Excel export) have been checked; then switch
# the header name to Content-Security-Policy. scripts/csp-hashes.mjs fills in script-src
# at build time with the hashes of the inline scripts (theme, self-measurement). Styles, images
# and fonts stay open to https: because session replay renders customers' pages in an iframe
# that inherits this policy.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https://cxmkdtgfocgbfizawlwa.supabase.co wss://cxmkdtgfocgbfizawlwa.supabase.co https://ssl.bing.com; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Force HTTPS. Loopia forwards the real scheme in X-Forwarded-Proto.
  #    Only redirect when we KNOW the edge request was http (prevents loops
  #    when the header is absent).
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Retired marketing URLs (keep in sync with MARKETING_REDIRECTS).
  RewriteRule ^bot-intelligence/?$ https://%{HTTP_HOST}/features/ai/ [L,R=301]

  # 3) Prerendered directory requested without the trailing slash: one 301,
  #    straight to the https canonical form.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [L,R=301]

  # 4) SPA fallback for client-only routes (dashboard, auth, navigation …).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>
