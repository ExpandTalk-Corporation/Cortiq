# CortIQ — Apache config for SPA + prerendered marketing pages
# Host: Loopia (nginx terminates TLS and forwards to Apache over plain http).
#
# Why this file matters for SEO:
#   The prerenderer writes dist/<route>/index.html (a directory per route),
#   but the sitemap, internal links and <link rel="canonical"> all use the
#   NO-slash form (https://cortiq.se/features). Apache's mod_dir would 301
#   /features -> /features/ and, because it sees http from the proxy, build
#   that redirect as http:// — so the canonical URL never returned 200.
#   We instead rewrite internally (no redirect), so /features serves
#   /features/index.html as 200 and matches the canonical exactly.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Force HTTPS. Loopia forwards the real scheme in X-Forwarded-Proto.
  #    Only redirect when we KNOW the edge request was http (prevents loops
  #    when the header is absent).
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Serve prerendered /route/index.html for /route WITHOUT an external
  #    redirect. This keeps the URL no-slash (matching the canonical) and
  #    preempts mod_dir's scheme-downgrading DirectorySlash redirect.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])/?$ /$1/index.html [L]

  # 3) SPA fallback for client-only routes (dashboard, auth, navigation …).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>
